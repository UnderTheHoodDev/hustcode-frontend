    "/problem": {
      "post": {
        "operationId": "ProblemController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProblemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The problem has been successfully created."
          },
          "400": {
            "description": "Bad Request. Invalid input data."
          }
        },
        "summary": "Create a new problem",
        "tags": ["problem"]
      },
      "get": {
        "operationId": "ProblemController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "example": 10,
              "type": "number"
            }
          },
          {
            "name": "difficulty",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["EASY", "MEDIUM", "HARD"],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["PENDING", "APPROVED", "REJECTED"],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "example": "two sum",
              "type": "string"
            }
          },
          {
            "name": "tags",
            "required": false,
            "in": "query",
            "schema": {
              "example": ["array", "hash-table"],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of problems retrieved successfully. Each problem includes userStatus: Solved (user has ACCEPTED submission), Attempted (user has submissions but none ACCEPTED), or Unsolved (no submissions)"
          }
        },
        "summary": "Get all problems with pagination and filters",
        "tags": ["problem"]
      }
    },
