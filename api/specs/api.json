            "description": "Contest created successfully"
          },
          "400": {
            "description": "Invalid input data"
          }
        },
        "summary": "Create a new contest",
        "tags": ["contests"]
      },
      "get": {
        "description": "Get paginated list of contests. Users see public contests and private contests they have access to.",
        "operationId": "ContestController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "example": 10,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["UPCOMING", "RUNNING", "FINISHED"],
              "type": "string"
            }
          },
          {
            "name": "isPublic",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of contests retrieved successfully"
          }
        },
        "summary": "Get all contests",
        "tags": ["contests"]
      }
    },
    "/contests/{id}": {
      "get": {
        "description": "Get detailed information about a contest including problems",
        "operationId": "ContestController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contest retrieved successfully"
          },
          "403": {
            "description": "Access denied to private contest"
          },
          "404": {
            "description": "Contest not found"
          }
        },
        "summary": "Get contest by ID",
        "tags": ["contests"]
      },
      "patch": {
        "description": "Update contest details. Only contest creator can update. Set isPublic=true to convert private contest to public.",
        "operationId": "ContestController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx123456789",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contest updated successfully"
          },
          "403": {
            "description": "Only contest creator can update"
          },
          "404": {
            "description": "Contest not found"
          }
        },
        "summary": "Update contest",
        "tags": ["contests"]
      },
      "delete": {
        "description": "Soft delete a contest. Only creator can delete.",
        "operationId": "ContestController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contest deleted successfully"
          },
          "403": {
            "description": "Only contest creator can delete"
          },
          "404": {
            "description": "Contest not found"
          }
        },
        "summary": "Delete contest",
        "tags": ["contests"]
      }
    },
    "/contests/problems": {
      "post": {
        "description": "Create a new contest-only problem. The problem will have CONTEST_ONLY visibility and won't appear in public problem list.",
        "operationId": "ContestController_createProblem",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContestProblemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contest problem created successfully"
          },
          "400": {
            "description": "Invalid input or order already exists"
          },
          "403": {
            "description": "Only contest creator can add problems"
          },
          "404": {
            "description": "Contest not found"
          }
        },
        "summary": "Create problem in contest",
        "tags": ["contests"]
      }
    },
    "/contests/{contestId}/problems/{problemId}": {
      "patch": {
        "description": "Update contest problem details including order, points, problem content, testcases, and constraints. Only contest creator can update.",
        "operationId": "ContestController_updateProblem",
        "parameters": [
          {
            "name": "contestId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx123456789",
              "type": "string"
            }
          },
          {
            "name": "problemId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx987654321",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContestProblemDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Problem updated successfully"
          },
          "400": {
            "description": "Invalid input or order conflict"
          },
          "403": {
            "description": "Only contest creator can update problems"
          },
          "404": {
            "description": "Contest or problem not found"
          }
        },
        "summary": "Update problem in contest",
        "tags": ["contests"]
      },
      "delete": {
        "description": "Remove a problem from contest and delete it (since it's contest-only). Only contest creator can remove problems.",
        "operationId": "ContestController_removeProblem",
        "parameters": [
          {
            "name": "contestId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx123456789",
              "type": "string"
            }
          },
          {
            "name": "problemId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "clxxx987654321",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Problem removed successfully"
          },
          "403": {
            "description": "Only contest creator can remove problems"
          },
          "404": {
            "description": "Contest or problem not found"
          }
        },
        "summary": "Remove problem from contest",
        "tags": ["contests"]
      }
    }
  },
  "info": {
    "title": "HustCode API Docs",
    "description": "HustCode API Docs",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "strongPassword123"
          }
        },
        "required": ["email", "password"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "strongPassword123"
          }
        },
        "required": ["email", "password"]
      },
      "CreateTestcaseDto": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "example": "5 3"
          },
          "output": {
            "type": "string",
            "example": "8"
          },
          "isSample": {
            "type": "boolean",
            "example": true,
            "description": "Is this a sample testcase shown to users?"
          }
        },
        "required": ["input", "output", "isSample"]
      },
      "CreateProblemConstraintDto": {
        "type": "object",
        "properties": {
          "memoryLimit": {
            "type": "number",
            "example": 256,
            "description": "Memory limit in MB"
          },
          "timeLimit": {
            "type": "number",
            "example": 2000,
            "description": "Time limit in milliseconds"
          }
        },
        "required": ["memoryLimit", "timeLimit"]
      },
      "CreateSolutionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "def solve(a, b):\n    return a + b"
          },
          "languageId": {
            "type": "string",
            "example": "1",
            "description": "Language ID"
          }
        },
        "required": ["code", "languageId"]
      },
      "CreateProblemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Two Sum"
          },
          "description": {
            "type": "string",
            "example": "Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target."
          },
          "tags": {
            "example": ["array", "hash-table"],
            "description": "Array of tag names. Tags will be created if they don't exist.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": ["EASY", "MEDIUM", "HARD"],
            "example": "EASY"
          },
          "taskDescription": {
            "type": "string",
            "example": "You are given an array of integers and a target. Find two numbers that sum to the target."
          },
          "inputDescription": {
            "type": "string",
            "example": "First line: n integers\nSecond line: target integer"
          },
          "outputDescription": {
            "type": "string",
            "example": "Two space-separated integers representing the indices"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"],
            "example": "PENDING",
            "description": "Defaults to PENDING if not provided"
          },
          "testcases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateTestcaseDto"
            }
          },
          "constraint": {
            "$ref": "#/components/schemas/CreateProblemConstraintDto"
          },
          "solution": {
            "$ref": "#/components/schemas/CreateSolutionDto"
          }
        },
        "required": [
          "title",
          "description",
          "tags",
          "difficulty",
          "taskDescription",
          "inputDescription",
          "outputDescription",
          "testcases",
          "constraint"
        ]
      },
      "UpdateProblemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Two Sum"
          },
          "description": {
            "type": "string",
            "example": "Given an array of integers nums and an integer target..."
          },
          "tags": {
            "example": ["array", "hash-table"],
            "description": "Array of tag names. Tags will be created if they don't exist.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
